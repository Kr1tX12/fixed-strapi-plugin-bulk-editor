{
  "name": "strapi-plugin-bulk-editor",
  "version": "0.1.11",
  "description": "Bulk edit Strapi entries in a spreadsheet-like interface",
  "license": "MIT",
  "author": "John Chedeville <hi@jchd.me>",
  "repository": {
    "type": "git",
    "url": "https://github.com/JTCHE/strapi-plugin-bulk-editor"
  },
  "keywords": [
    "strapi",
    "strapi-plugin",
    "bulk-edit",
    "spreadsheet",
    "batch-update"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "verify": "strapi-plugin verify"
  },
  "strapi": {
    "name": "bulk-editor",
    "displayName": "Bulk Editor",
    "description": "Edit multiple entries at once in a spreadsheet view",
    "kind": "plugin"
  },
  "main": "./strapi-server.js",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "source": "./admin/src/index.tsx",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "admin",
    "server",
    "strapi-admin.js",
    "strapi-server.js"
  ],
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^6.1.1",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
